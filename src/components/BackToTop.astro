---
// Small fixed corner button, faded in once the user has scrolled past one
// viewport height. Uses `inert` (not just opacity) so it drops out of the
// tab order while hidden, matching the pattern in MenuOverlay.astro.
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="back-to-top fixed bottom-5 right-5 z-40 w-11 h-11 rounded-full border border-gold/40 bg-lacquer/70 backdrop-blur-sm flex items-center justify-center text-gold cursor-pointer opacity-0 transition-[opacity,background-color,border-color,color] duration-300 hover:bg-gold hover:text-lacquer hover:border-gold"
  inert
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"/>
    <path d="M6 11l6-6 6 6"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setVisible(visible: boolean) {
    btn.classList.toggle('is-visible', visible);
    btn.toggleAttribute('inert', !visible);
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        setVisible(window.scrollY > window.innerHeight * 0.6);
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
  });
</script>

<style>
  .back-to-top.is-visible { opacity: 1; }
</style>
