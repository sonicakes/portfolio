---
// Golden Khokhloma inversion: the single gold surface on the page.
// Closes the page like turning the spoon over — black → black → black → gold.
// Must remain singular; a second gold section would destroy the effect (§3.9).
import Spoons from './Spoons.astro';
---

<section id="contact" class="rise max-w-265 mx-auto px-6 py-18">
  <div class="relative text-center rounded bg-[linear-gradient(165deg,#f4bc27_0%,#e8a70f_55%,#cf920c_100%)] text-lacquer py-13 px-6 before:content-[''] before:absolute before:inset-2 before:rounded-xs before:border-[1.5px] before:border-lacquer/55 before:pointer-events-none">
    <Spoons />

    <h2 class="font-display font-normal text-lacquer text-[clamp(1.5rem,3.6vw,2.1rem)] tracking-wider text-center mb-2">Commission a piece</h2>
    <p class="max-w-130 mx-auto mb-6.5 text-[#4d3c08]">
     Available for front-end, design & content work. If you want a site with an actual point of view, drop me a line at <a href="mailto:hire-me@soniaparker.net" class="text-lacquer font-bold rounded-xs transition-color duration-200 hover:text-crimson">hire-me@soniaparker.net</a>

    </p>

    <div class="flex justify-center flex-wrap gap-4 font-mono text-[.85rem] tracking-[.08em] mb-6.5">
      <a href="/cv.pdf" download class="text-gold bg-lacquer border border-lacquer px-6 py-2.5 rounded-xs transition-[background,color] duration-200 hover:bg-crimson hover:border-crimson hover:text-lacquer">Résumé</a>
    </div>

    <div class="flex justify-center items-center gap-5">
      <a href="#" aria-label="GitHub" class="text-lacquer hover:text-crimson-deep transition-colors">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 013.003-.404c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>
      <a href="#" aria-label="LinkedIn" class="text-lacquer hover:text-crimson-deep transition-colors">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </div>
</section>
