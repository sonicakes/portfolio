---
interface Props {
  title: string;
  kind: string;
  description: string;
  tags: string[];
  roles?: string[];
  live?: string;
  github?: string;
  challenge?: string;
  image?: string;
  featured?: boolean;
  hidden?: boolean;
}
const { title, kind, description, tags, roles, live, github, challenge, image, featured = false, hidden = false } = Astro.props;
---

<article
  class:list={[
    'relative flex flex-col rounded overflow-hidden transition-[border-color,transform] duration-300 hover:-translate-y-[3px] motion-reduce:transition-none',
    'bg-[linear-gradient(135deg,rgba(255,255,255,.05)_0%,transparent_35%),linear-gradient(160deg,#181510_0%,#100d09_60%,#0a0806_100%)]',
    'before:content-[\'\'] before:absolute before:inset-1.5 before:rounded-xs before:pointer-events-none',
    featured
      ? 'border-2 border-gold/50 shadow-[0_6px_20px_rgba(240,179,28,.16)] hover:border-gold before:border before:border-gold/25'
      : 'border border-hairline shadow-[0_4px_12px_rgba(240,179,28,.1)] hover:border-gold before:border before:border-crimson/25',
    hidden && 'hidden',
  ]}
  data-roles={roles?.join(',')}
>
  {featured && (
    <span class="absolute top-3.5 left-3.5 z-10 font-mono text-[.62rem] tracking-[.16em] uppercase text-lacquer bg-gold px-2 py-[3px] rounded-xs">Featured</span>
  )}

  {image ? (
    <img src={image} alt={`${title} preview`} class='w-full object-cover aspect-square' loading="lazy" />
  ) : (
    <div class:list={['thumb-placeholder relative flex flex-col items-center justify-center gap-2 w-full border-b border-hairline', featured ? 'aspect-square' : 'aspect-[4/3]']} aria-hidden="true">
      <div class="flex gap-1.25">
        <i class="relative block w-2 h-2 rounded-full bg-crimson/50 after:content-[''] after:absolute after:inset-[2.5px] after:rounded-full after:bg-crimson-deep/60"></i>
        <i class="relative block w-2 h-2 rounded-full bg-crimson/50 after:content-[''] after:absolute after:inset-[2.5px] after:rounded-full after:bg-crimson-deep/60"></i>
        <i class="relative block w-2 h-2 rounded-full bg-crimson/50 after:content-[''] after:absolute after:inset-[2.5px] after:rounded-full after:bg-crimson-deep/60"></i>
      </div>
      <span class="font-mono text-[.68rem] tracking-[.1em] uppercase text-ink-dim">Image coming soon</span>
    </div>
  )}

  <div class:list={['relative flex flex-col flex-1', featured ? 'px-7 pt-7 pb-6.5' : 'px-6 pt-6.5 pb-5.5']}>
    <!-- Three CSS-only berry dots: brand echo, zero assets -->
    <div class="absolute top-3.5 right-3.5 flex gap-[5px]" aria-hidden="true">
      <i class="relative block w-2 h-2 rounded-full bg-crimson after:content-[''] after:absolute after:inset-[2.5px] after:rounded-full after:bg-crimson-deep"></i>
      <i class="relative block w-2 h-2 rounded-full bg-crimson after:content-[''] after:absolute after:inset-[2.5px] after:rounded-full after:bg-crimson-deep"></i>
      <i class="relative block w-2 h-2 rounded-full bg-crimson after:content-[''] after:absolute after:inset-[2.5px] after:rounded-full after:bg-crimson-deep"></i>
    </div>

    <h3 class:list={['font-display font-normal text-gold tracking-[.04em] mb-1 pr-11', featured ? 'text-[1.32rem]' : 'text-[1.18rem]']}>{title}</h3>
    <p class="font-mono text-[.72rem] tracking-[.16em] uppercase text-crimson mb-3.5">{kind}</p>
    <p class:list={['text-ink-cream flex-1', featured ? 'text-[1rem]' : 'text-[.95rem]']}>{description}</p>

    <div class="flex flex-wrap gap-[7px] mt-4.5">
      {tags.map(tag => <i class="not-italic font-mono text-[.7rem] tracking-wider text-green-vine border border-green-vine/55 px-[9px] py-[3px] rounded-xs">{tag}</i>)}
    </div>

    <div class="flex flex-wrap gap-2 mt-4 pt-3.5 border-t border-dotted border-ink-cream/15">
      {live ? (
        <a href={live} target="_blank" rel="noopener noreferrer" class="font-mono text-[.7rem] tracking-wider uppercase text-lacquer bg-gold px-3 py-1.25 rounded-xs transition-colors hover:bg-gold-deep">Live site ↗</a>
      ) : (
        <span class="font-mono text-[.7rem] tracking-wider uppercase text-ink-dim border border-dashed border-hairline px-3 py-1.25 rounded-xs opacity-60">Live — soon</span>
      )}
      {github ? (
        <a href={github} target="_blank" rel="noopener noreferrer" class="font-mono text-[.7rem] tracking-wider uppercase text-gold border border-gold/50 px-3 py-1.25 rounded-xs transition-colors hover:bg-gold hover:text-lacquer">Code ↗</a>
      ) : (
        <span class="font-mono text-[.7rem] tracking-wider uppercase text-ink-dim border border-dashed border-hairline px-3 py-1.25 rounded-xs opacity-60">Code — soon</span>
      )}
      {challenge && <a href={challenge} target="_blank" rel="noopener noreferrer" class="font-mono text-[.7rem] tracking-wider uppercase text-ink-dim border border-hairline px-3 py-1.25 rounded-xs transition-colors hover:border-crimson hover:text-crimson">Brief ↗</a>}
    </div>
  </div>
</article>
