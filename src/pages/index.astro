---
import Base from '../layouts/Base.astro';
import Kustik from '../components/Kustik.astro';
import Spoons from '../components/Spoons.astro';
import ChipFlower from '../components/ChipFlower.astro';
import ChipBerry from '../components/ChipBerry.astro';
import Divider from '../components/Divider.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FactPanel from '../components/FactPanel.astro';
import ContactPanel from '../components/ContactPanel.astro';

// `roles` drive the Work filter pills; `featured` sorts a project first and gives it the larger card treatment.
// `github` / `image` are left blank for pieces still awaiting links & screenshots.
const projects = [
  {
    title: 'Kino Royale',
    kind: 'Podcast platform',
    description:
      'Full production site for an independent film-criticism podcast: git-backed CMS, custom RSS feed endpoint, zero-egress audio delivery, and a bespoke design system with strict token rules.',
    tags: ['Next.js 15', 'TypeScript', 'Tailwind v4', 'Decap CMS', 'Cloudflare R2'],
    roles: ['dev', 'content'],
    featured: true,
    live: 'https://kinoroyale.net',
    github: '',
    image: '/projs/kino-royale-pod.png',
  },
  {
    title: 'Cinefile Blog',
    kind: 'Publication',
    description:
      'A film review publication built and operated end-to-end: custom domain and DNS, static delivery, and long-form criticism with proper Chicago-style citations.',
    tags: ['Strapi Headless CMS', 'Neon Postgres', 'Custom DNS', 'Editorial design'],
    roles: ['content', 'dev'],
    featured: true,
    live: 'https://cinefileblog.com',
    github: '',
    image: '/projs/cinefile-blog.png',
  },
  {
    title: 'Royal Simulator',
    kind: 'Browser game',
    description:
      'A darkly comic choose-your-fate horror game with a large library of authored scenarios driven from a single JSON data file, styled after Polish film posters.',
    tags: ['React', 'React Router v7', 'TypeScript', 'Tailwind v4', 'Netlify'],
    roles: ['dev', 'design'],
    featured: true,
    live: 'https://royal-simulator.netlify.app/',
    github: '',
    image: '/projs/royal-simulator-poster.png',
  },
  {
    title: 'Film Lady Productions',
    kind: 'Studio site',
    description:
      'The home base for my independent production label — "a court of cinema, criticism & controlled chaos" tying together Kino Royale, Cinefile Blog and other self-directed work under one identity.',
    tags: ['Gatsby 5', 'Tailwind v4', 'Typescript', 'GSAP'],
    roles: ['dev', 'content', 'design'],
    featured: false,
    live: 'https://filmladyproductions.netlify.app/',
    github: '',
    image: '/projs/filmladyprods.png',
  },
    {
    title: 'Space Tourism',
    kind: 'Frontend Mentor challenge',
    description:
      'A multi-page space-tourism site with per-page layout and typography shifts across breakpoints — Frontend Mentor\'s most detailed responsive design brief.',
    tags: ['React Router', 'Vite', 'Tailwind CSS'],
    roles: ['design', 'dev'],
    featured: false,
    live: 'https://space-tourism-cakes.netlify.app/',
    github: '',
    challenge: 'https://www.frontendmentor.io/challenges/space-tourism-multipage-website-gRWj1URZ3',
    image: '/projs/space.png',
  },
    {
    title: 'Weather App',
    kind: 'Frontend Mentor challenge',
    description:
      'A weather lookup app pulling live forecast data by location, with unit toggling and responsive loading/error states.',
    tags: ['React', 'Vite', 'Weather API'],
    roles: ['dev'],
    featured: false,
    live: 'https://weather-cakes.netlify.app/',
    github: '',
    challenge: 'https://www.frontendmentor.io/challenges/weather-app-K1FhddVm49',
    image: '/projs/weather.png',
  },


];

// Featured projects sort first but stay mixed into the same filterable grid.
const sortedProjects = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));

const workFilters = [
  { key: 'all',     label: 'All' },
  { key: 'design',  label: 'Design' },
  { key: 'dev',     label: 'Dev' },
  { key: 'content', label: 'Content' },
];

const facts = [
  { label: 'Base',            value: 'Sydney, Australia' },
  { label: 'Origins',         value: 'The Town of N, Russia' },
  { label: 'Experience',      value: '7+ years professional' },
  { label: 'Education',       value: "Curtin Uni, AU '23 · BA in Digital Design & Interaction" },
  { label: 'Cloud',           value: 'Azure certified (AZ-104)' },
  { label: 'Focus',           value: 'Front-end dev, UI/UX & Creative' },
  { label: 'Methodology',     value: 'Agile/Scrum · Code review & QA' },
  { label: 'Human Languages', value: 'RU (native) · EN (fluent) · FR/ES (working) · TH (basic)' },
  { label: 'Off-duty',        value: 'Cinephile · Cynophile · Bibliophile · Linguaphile · Logophile' },
];

const craftColumns = [
  {
    heading: 'Front of house',
    items: [
      'TypeScript & modern JavaScript',
      'React, Next.js & Vue.js',
      'Tailwind CSS & design tokens',
      'Figma, Adobe XD & InVision',
      'Adobe Suite & Canva',
      'Accessible, responsive UI',
    ],
  },
  {
    heading: 'Back of house',
    items: [
      'C# / .NET & Blazor',
      'Sitecore, Kentico & Umbraco',
      'Shopify, WordPress & Strapi',
      'Node.js & PostgreSQL (Neon)',
      'REST APIs & RSS pipelines',
    ],
  },
  {
    heading: 'Workshop',
    items: [
      'Azure — certified administrator (AZ-104)',
      'Netlify, Vercel & Cloudflare',
      'Railway & Render',
      'GitHub & CI/CD pipelines',
      'Claude Code, Gemini & AI-assisted workflows',
    ],
  },
];
---

<Base>

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <header class="text-center relative px-12 pb-11 bg-[radial-gradient(ellipse_70%_55%_at_50%_38%,rgba(240,179,28,.02)_0%,rgba(200,120,12,.012)_40%,transparent_70%),radial-gradient(ellipse_40%_30%_at_50%_22%,rgba(240,179,28,.015)_0%,transparent_100%)]">
    <Kustik />
    <h1 class="font-display font-normal text-[clamp(2.6rem,7vw,4.4rem)] text-gold tracking-wider leading-[1.05] text-shadow-[0_0_26px_rgba(240,179,28,.22)]">Sonia</h1>
    <p class="font-display text-[clamp(1.1rem,2.8vw,1.55rem)] text-ink-dim tracking-[.08em] -mt-1.5">Parker</p>

    <div class="flex justify-center flex-wrap gap-4 mt-4">
      <a class="inline-block font-mono text-[.85rem] tracking-[.12em] uppercase text-gold border border-gold/50 px-7.5 py-3 rounded-xs transition-[background,color] duration-250 hover:bg-gold hover:text-lacquer max-[620px]:order-1" href="/cv.pdf" download>Résumé</a>
      <a class="hero-cta inline-block font-mono text-[.85rem] tracking-[.12em] uppercase text-lacquer bg-gold border border-gold-deep px-7.5 py-3 rounded-xs transition-[background,color,border-color] duration-250 hover:bg-transparent hover:border-gold-deep hover:text-gold max-[620px]:order-3" href="#work-all">my work</a>
      <a class="inline-block font-mono text-[.85rem] tracking-[.12em] uppercase text-gold border border-gold/50 px-7.5 py-3 rounded-xs transition-[background,color] duration-250 hover:bg-gold hover:text-lacquer max-[620px]:order-2" href="mailto:hire-me@soniaparker.net">Email Me</a>
    </div>

    <!-- Vine arrows: branch from name down to each role card -->
    <svg class="role-vines block w-[min(600px,100%)] h-22 mt-1.5 mx-auto overflow-visible" viewBox="0 0 580 88" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
      <!-- Left stem → Digital Designer -->
      <path class="rv-stem rv-stem--l" pathLength="1"
        d="M290,2 C270,18 230,30 185,46 C155,57 120,64 92,74"
        fill="none" stroke="rgba(30,74,31,.38)" stroke-width="2.8" stroke-linecap="round"/>
      <!-- Centre stem → Front-End Dev -->
      <path class="rv-stem rv-stem--c" pathLength="1"
        d="M290,2 C294,22 286,48 290,74"
        fill="none" stroke="rgba(30,74,31,.38)" stroke-width="2.8" stroke-linecap="round"/>
      <!-- Right stem → Content Creator -->
      <path class="rv-stem rv-stem--r" pathLength="1"
        d="M290,2 C310,18 350,30 395,46 C425,57 460,64 488,74"
        fill="none" stroke="rgba(30,74,31,.38)" stroke-width="2.8" stroke-linecap="round"/>
      <!-- Curling side tendrils -->
      <path class="rv-tendril" pathLength="1"
        d="M185,46 C178,36 166,34 163,42 C161,48 167,53 174,49"
        fill="none" stroke="rgba(63,109,42,.3)" stroke-width="1.8" stroke-linecap="round"/>
      <path class="rv-tendril" pathLength="1"
        d="M395,46 C402,36 414,34 417,42 C419,48 413,53 406,49"
        fill="none" stroke="rgba(63,109,42,.3)" stroke-width="1.8" stroke-linecap="round"/>
      <!-- Berry tips at card entrances -->
      <g class="rv-berry">
        <circle cx="92"  cy="76" r="5.5" fill="#e0272d"/><circle cx="92"  cy="76" r="2" fill="#7c0f12"/>
        <circle cx="290" cy="76" r="5.5" fill="#e0272d"/><circle cx="290" cy="76" r="2" fill="#7c0f12"/>
        <circle cx="488" cy="76" r="5.5" fill="#e0272d"/><circle cx="488" cy="76" r="2" fill="#7c0f12"/>
      </g>
    </svg>

    <div class="hero-roles flex justify-center gap-7 flex-wrap mt-0 w-full max-[620px]:flex-col max-[620px]:items-center">
      <div class="role-chip perspective-[900px] flex-1 min-w-35 max-w-60 h-60 cursor-pointer max-[620px]:w-56 max-[620px]:max-w-70 max-[620px]:flex-none">
        <div class="chip-inner relative w-full h-full transform-3d">
          <div class="chip-front absolute inset-0 rounded border border-hairline backface-hidden flex flex-col items-center justify-center gap-2.5 px-5 pt-5 pb-4.5 bg-[linear-gradient(135deg,rgba(255,255,255,.05)_0%,transparent_35%),linear-gradient(160deg,#181510_0%,#100d09_60%,#0a0806_100%)] shadow-[0_4px_12px_rgba(240,179,28,.1)] before:content-[''] before:absolute before:inset-1.75 before:rounded-xs before:border before:border-crimson/25 before:pointer-events-none">
            <ChipFlower />
            <span class="font-display text-base tracking-wider text-gold">Digital Designer</span>
            <span class="chip-tap font-body text-[.72rem] tracking-[.04em] text-ink-dim opacity-70" aria-hidden="true">Tap to reveal</span>
          </div>
          <div class="chip-back absolute inset-0 rounded backface-hidden flex flex-col items-center justify-center gap-2 px-5 pt-5 pb-4.5 transform-[rotateY(180deg)] bg-[linear-gradient(165deg,#f4bc27_0%,#e8a70f_55%,#cf920c_100%)] before:content-[''] before:absolute before:inset-2 before:rounded-xs before:border-[1.5px] before:border-lacquer/40 before:pointer-events-none">
            <span class="font-display text-base text-lacquer tracking-wider">Digital Designer</span>
            <p class="font-mono text-[.72rem] tracking-[.06em] text-[#4d3c08] leading-[1.7] text-center">UI/UX · Design systems<br/>Figma → production code</p>
            <a href="#work-all" data-work-filter="design" class="mt-1.5 font-mono text-[.72rem] tracking-widest uppercase text-lacquer border border-lacquer/50 px-3.5 py-1.75 rounded-xs transition-[background,color] duration-200 hover:bg-lacquer hover:text-gold">See design work</a>
          </div>
        </div>
      </div>
      <div class="role-chip perspective-[900px] flex-1 min-w-35 max-w-60 h-60 cursor-pointer max-[620px]:w-56 max-[620px]:max-w-70 max-[620px]:flex-none">
        <div class="chip-inner relative w-full h-full transform-3d">
          <div class="chip-front absolute inset-0 rounded border border-hairline backface-hidden flex flex-col items-center justify-center gap-2.5 px-5 pt-5 pb-4.5 bg-[linear-gradient(135deg,rgba(255,255,255,.05)_0%,transparent_35%),linear-gradient(160deg,#181510_0%,#100d09_60%,#0a0806_100%)] shadow-[0_4px_12px_rgba(240,179,28,.1)] before:content-[''] before:absolute before:inset-1.75 before:rounded-xs before:border before:border-crimson/25 before:pointer-events-none">
            <Spoons />
            <span class="font-display text-base tracking-wider text-gold">Front-End Dev</span>
            <span class="chip-tap font-body text-[.72rem] tracking-[.04em] text-ink-dim opacity-70" aria-hidden="true">Tap to reveal</span>
          </div>
          <div class="chip-back absolute inset-0 rounded backface-hidden flex flex-col items-center justify-center gap-2 px-5 pt-5 pb-4.5 transform-[rotateY(180deg)] bg-[linear-gradient(165deg,#f4bc27_0%,#e8a70f_55%,#cf920c_100%)] before:content-[''] before:absolute before:inset-2 before:rounded-xs before:border-[1.5px] before:border-lacquer/40 before:pointer-events-none">
            <span class="font-display text-base text-lacquer tracking-wider">Front-End Dev</span>
            <p class="font-mono text-[.72rem] tracking-[.06em] text-[#4d3c08] leading-[1.7] text-center">Vue · React · TypeScript<br/>Tailwind · CSS</p>
            <a href="#work-all" data-work-filter="dev" class="mt-1.5 font-mono text-[.72rem] tracking-widest uppercase text-lacquer border border-lacquer/50 px-3.5 py-1.75 rounded-xs transition-[background,color] duration-200 hover:bg-lacquer hover:text-gold">See dev projects</a>
          </div>
        </div>
      </div>
      <div class="role-chip perspective-[900px] flex-1 min-w-35 max-w-60 h-60 cursor-pointer max-[620px]:w-56 max-[620px]:max-w-70 max-[620px]:flex-none">
        <div class="chip-inner relative w-full h-full transform-3d">
          <div class="chip-front absolute inset-0 rounded border border-hairline backface-hidden flex flex-col items-center justify-center gap-2.5 px-5 pt-5 pb-4.5 bg-[linear-gradient(135deg,rgba(255,255,255,.05)_0%,transparent_35%),linear-gradient(160deg,#181510_0%,#100d09_60%,#0a0806_100%)] shadow-[0_4px_12px_rgba(240,179,28,.1)] before:content-[''] before:absolute before:inset-1.75 before:rounded-xs before:border before:border-crimson/25 before:pointer-events-none">
            <ChipBerry />
            <span class="font-display text-base tracking-wider text-gold">Content Creator</span>
            <span class="chip-tap font-body text-[.72rem] tracking-[.04em] text-ink-dim opacity-70" aria-hidden="true">Tap to reveal</span>
          </div>
          <div class="chip-back absolute inset-0 rounded backface-hidden flex flex-col items-center justify-center gap-2 px-5 pt-5 pb-4.5 transform-[rotateY(180deg)] bg-[linear-gradient(165deg,#f4bc27_0%,#e8a70f_55%,#cf920c_100%)] before:content-[''] before:absolute before:inset-2 before:rounded-xs before:border-[1.5px] before:border-lacquer/40 before:pointer-events-none">
            <span class="font-display text-base text-lacquer tracking-wider">Content Creator</span>
            <p class="font-mono text-[.72rem] tracking-[.06em] text-[#4d3c08] leading-[1.7] text-center">Kino Royale Podcast · <br/>The Cinefile Blog · Production</p>
            <a href="#work-all" data-work-filter="content" class="mt-1.5 font-mono text-[.72rem] tracking-widest uppercase text-lacquer border border-lacquer/50 px-3.5 py-1.75 rounded-xs transition-[background,color] duration-200 hover:bg-lacquer hover:text-gold">See content work</a>
          </div>
        </div>
      </div>
    </div>
  </header>
  <!-- Spoon handle: flow element between bowl and divider -->
  <div class="w-1.5 h-9 mx-auto rounded-b bg-[linear-gradient(to_bottom,rgba(240,179,28,.55),rgba(240,179,28,.22))] shadow-[0_6px_16px_rgba(0,0,0,.4),0_2px_6px_rgba(0,0,0,.3)]" aria-hidden="true"></div>

  <Divider phase="a" />

  <!-- ── About ─────────────────────────────────────────────────────────── -->
  <section id="about" class="rise max-w-265 mx-auto px-6 py-18">
    <h2 class="font-display font-normal text-gold text-[clamp(1.5rem,3.6vw,2.1rem)] tracking-wider text-center mb-2">About</h2>
    <p class="sub text-center font-mono text-[.78rem] tracking-[.22em] uppercase text-ink-dim mb-11">The artisan behind the lacquer</p>
    <div class="about-grid grid grid-cols-[1.4fr_1fr] gap-11 items-start max-[760px]:grid-cols-1">
      <div>
        <p>
          <img src="/avatar.jpg" alt="Sonia Parker" class="avatar float-left w-50 h-50 rounded-full object-cover mt-1 mr-5.5 mb-3 ml-0 border-2 border-gold/45 shadow-[0_0_0_4px_rgba(240,179,28,.08),0_8px_24px_rgba(0,0,0,.5)] [shape-outside:circle(50%)] max-[760px]:float-none max-[760px]:block max-[760px]:mx-auto max-[760px]:mt-0 max-[760px]:mb-5" />
          <span class="capitalize font-bold">привет! (Privet! - Hello!) </span>I'm a Russian-Australian Designer, Developer & Content Creator based around Sydney, Australia.

           I treat interfaces the way Khokhloma
          masters treat wood: start with a dark, quiet ground, then apply ornament
          only where it earns its place. Most of my work lives at the front-end but also the design decisions underneath: type scales,
          spacing systems, interaction states. What I find most interesting is the
          distance between a design file and a finished interface, and how much
          craft it takes to close it faithfully.
        </p>
        <p class="mt-3.5">
          I didn't start here. My first degree was a Master's in International
          Economics back in Russia — reading systems, not building them. As a lover of human languages, I was also enrolled in minor Professional Translation & Interpretation Degree with focus on Business English, French & Spanish. 
        </p>
        <p class="mt-3.5">After I arrived in Australia I taught myself to code since I felt like my heart was not quite in Global Finances & Commerce. I further undertook a
          bootcamp-style course in Web Development Immersive, whilst also pursuing a Bachelor of Arts in Digital
          Experience & Interaction Design. </p>
          <p class="mt-3.5">Since 2018 I've worked front-of-house and
          back across agency and client sites in parking, mining, hospitality,
          retail industries, to list a few. Apart from 9-5 routine, I've picked up an Azure administrator
          certification along the way, whilst remaining active in tech community by mentoring & volunteering at coding-related events (Women Who Code, Code Like A Girl) - in-person at first, then remotely after Covid hit in 2020.</p>
        <p class="mt-3.5">
          To fulfill my long-term dream of having my own creative establishment, I run an independent production label where I build
          everything myself end-to-end: a podcast platform on Next.js 15, a browser
          game in React, and a movie blog — my own three-panel folk triptych of code,
          film criticism and mischief.
        </p>
        <p class="mt-3.5">
          The artwork on this page is based on IRL spoon brought from Russia. I created it myself in AI - Adobe Illustrator, not ChatGPT: back then things were done by hand, hehe —
          as part of my degree assignments. But of course, we need to move on with the times - Claude Code has assisted with manual parts of coding the components & logic for this portfolio (& most of my recent projects, too!).
        </p>
      </div>
      <FactPanel facts={facts} />
    </div>
  </section>

  <Divider phase="b" />

  <!-- ── Work ──────────────────────────────────────────────────────────── -->
  <section id="work" class="rise max-w-265 mx-auto px-6 py-18">
    <h2 class="font-display font-normal text-gold text-[clamp(1.5rem,3.6vw,2.1rem)] tracking-wider text-center mb-2">Work</h2>
    <p class="sub text-center font-mono text-[.78rem] tracking-[.22em] uppercase text-ink-dim mb-9">Painted, fired, shipped</p>

    <div id="work-all" class="work-filters flex justify-center gap-2.5 flex-wrap mb-9" role="tablist" aria-label="Filter work by role">
      {workFilters.map(f => (
        <button
          type="button"
          class="work-filter-pill font-mono text-[.72rem] tracking-[.12em] uppercase px-4 py-1.75 rounded-xs border border-hairline text-ink-dim cursor-pointer transition-[border-color,color] duration-200 hover:text-gold hover:border-gold/50"
          data-role={f.key}
          role="tab"
          aria-selected={f.key === 'all' ? 'true' : 'false'}
          aria-controls="work-all-grid"
        >{f.label}</button>
      ))}
    </div>

    <!-- Featured projects sort first; the rest load in on demand -->
    <div id="work-all-grid" class="cards grid grid-cols-3 gap-5.5 max-[880px]:grid-cols-1">
      {sortedProjects.filter(p => p.featured).map(p => (
        <ProjectCard
          title={p.title}
          kind={p.kind}
          description={p.description}
          tags={p.tags}
          roles={p.roles}
          live={p.live}
          github={p.github}
          challenge={p.challenge}
          image={p.image}
          featured
        />
      ))}

      <button
        type="button"
        id="work-load-more"
        class="col-span-3 max-[880px]:col-span-1 justify-self-center inline-flex items-center justify-center gap-1 font-mono text-[.78rem] tracking-[.14em] uppercase text-gold border border-gold/50 px-6 py-2.5 rounded-xs cursor-pointer transition-colors hover:bg-gold hover:text-lacquer"
      >Load more work<span aria-hidden="true">↓</span></button>

      {sortedProjects.filter(p => !p.featured).map(p => (
        <ProjectCard
          title={p.title}
          kind={p.kind}
          description={p.description}
          tags={p.tags}
          roles={p.roles}
          live={p.live}
          github={p.github}
          challenge={p.challenge}
          image={p.image}
          hidden
        />
      ))}
    </div>
    <p id="work-empty" class="hidden text-center font-mono text-[.85rem] text-ink-dim mt-8">
      Nothing filed under that craft yet.
    </p>
  </section>

  <Divider phase="a" />

  <!-- ── Craft ─────────────────────────────────────────────────────────── -->
  <section id="craft" class="rise max-w-265 mx-auto px-6 py-18">
    <h2 class="font-display font-normal text-gold text-[clamp(1.5rem,3.6vw,2.1rem)] tracking-wider text-center mb-2">Craft</h2>
    <p class="sub text-center font-mono text-[.78rem] tracking-[.22em] uppercase text-ink-dim mb-11">Tools of the trade</p>
    <div class="craft-grid grid grid-cols-3 gap-5.5 max-[880px]:grid-cols-1">
      {craftColumns.map(col => (
        <div class="craft border-t-2 border-crimson pt-4.5">
          <h3 class="font-mono font-normal text-[.8rem] tracking-[.2em] uppercase text-gold mb-3">{col.heading}</h3>
          <ul class="list-none">
            {col.items.map(item => <li class="craft-li py-1.5 pl-5.5 relative text-[.96rem]">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <Divider phase="b" />

  <!-- ── Story ─────────────────────────────────────────────────────────── -->
  <section id="story" class="rise max-w-265 mx-auto px-6 py-18">
    <h2 class="font-display font-normal text-gold text-[clamp(1.5rem,3.6vw,2.1rem)] tracking-wider text-center mb-2">Khokhloma</h2>
    <p class="sub text-center font-mono text-[.78rem] tracking-[.22em] uppercase text-ink-dim mb-11">Folk art, rendered in code</p>
    <div class="story-grid grid grid-cols-[1fr_240px] gap-13 items-start max-[760px]:grid-cols-1">
      <div class="story-prose">
        <p>
          Khokhloma is a Russian folk painting tradition from the 17th century, originating
          in the forests of the Nizhny Novgorod region. Craftspeople decorated turned wooden
          objects — bowls, ladles, spoons — with a black lacquer ground, then applied
          ornament in red, gold, and green before firing in a kiln. Heat transformed silver
          tin powder into gold, producing the characteristic warm gleam of genuine Khokhloma
          lacquerware. The four colours — black, crimson, gold, green — have not changed
          in three centuries.
        </p>
        <p class="mt-4">
          The style used here is Kudrina — a variation built on movement rather than
          pattern. Where standard Khokhloma fills the ground with isolated berries and
          leaves, Kudrina composes a <em class="italic text-gold">kustik</em> (little bush): a central rosette
          anchoring spiralling vine tendrils, with rowan clusters appearing where the
          stems branch. It is a style with a strict painting order — vine framework first,
