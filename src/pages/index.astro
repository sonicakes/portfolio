<!-- Section rise-in: IntersectionObserver, threshold .12, fires once per section -->
<script>
  const io = new IntersectionObserver(
    entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.rise').forEach(el => io.observe(el));

  // Flip cards: tap to toggle on touch devices
  document.querySelectorAll('.role-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      chip.classList.toggle('flipped');
    });
  });

  // All Work filter: pills + hero-chip shortcuts both drive the same grid
  const pills = document.querySelectorAll<HTMLButtonElement>('.work-filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('#work-all-grid [data-roles]');
  const emptyMsg = document.getElementById('work-empty');
  const loadMoreBtn = document.getElementById('work-load-more');

  // Catalog cards render with the `.hidden` class until this fires — filtering
  // or the button both need the full set loaded, so both funnel through here first.
  function revealCatalog() {
    cards.forEach(c => c.classList.remove('hidden'));
    loadMoreBtn?.classList.add('hidden');
  }

  function currentFilter(): string {
    const active = document.querySelector<HTMLButtonElement>('.work-filter-pill.active');
    return active?.dataset.role ?? 'all';
  }

  function applyWorkFilter(role: string) {
    pills.forEach(p => {
      const active = p.dataset.role === role;
      p.classList.toggle('active', active);
      p.setAttribute('aria-selected', String(active));
    });
    let visible = 0;
    cards.forEach(c => {
      const roles = (c.dataset.roles ?? '').split(',');
      const show = role === 'all' || roles.includes(role);
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyMsg?.classList.toggle('hidden', visible > 0);
  }

  loadMoreBtn?.addEventListener('click', () => {
    revealCatalog();
    applyWorkFilter(currentFilter());
  });

  pills.forEach(p => p.addEventListener('click', () => {
    revealCatalog();
    applyWorkFilter(p.dataset.role!);
  }));

  document.querySelectorAll<HTMLAnchorElement>('[data-work-filter]').forEach(link => {
    link.addEventListener('click', () => {
      revealCatalog();
      applyWorkFilter(link.dataset.workFilter!);
    });
  });

  applyWorkFilter('all');
</script>

